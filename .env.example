# auto = try free local Ollama first, then Anthropic (only if a key is set), else no LLM
LLM_PROVIDER=auto

# Free, local (https://ollama.com):  ollama pull llama3.2
OLLAMA_URL=http://localhost:11434
OLLAMA_MODEL=llama3.2

# Optional, paid. Leave blank to stay 100% free.
ANTHROPIC_API_KEY=
LLM_MODEL=claude-sonnet-5-5

# DISABLE_LLM=1
